# ============================================
# Supabase
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# Email (Resend)
# ============================================
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ============================================
# AI (StringingMode recommendations)
# ============================================
AI_PROVIDER=openai
AI_API_KEY=sk-your-key
AI_MODEL=gpt-4o-mini

# ============================================
# App
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Stripe — required for paid plans, Day Pass, billing portal
# ============================================
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs from your Stripe Dashboard (one Pro plan + Day Pass):
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_ANNUAL=price_xxx
STRIPE_PRICE_DAY_PASS=price_xxx

# ============================================
# Twilio — Phase 3 (SMS notifications)
# ============================================
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+15551234567

# ============================================
# ElevenLabs — Phase 4 (DJ Console announcer)
# ============================================
ELEVENLABS_API_KEY=xxx
ELEVENLABS_VOICE_ID=nPczCjzI2devNBz1zQrb  # Brian — hype announcer
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ============================================
# Pixabay Music — Phase 4 (DJ Console walkout songs)
# ============================================
PIXABAY_API_KEY=xxx

# ============================================
# Sales CRM (/crm) — private to the two people who sell ClubMode
# ============================================
# WHO may open it is a row in crm_users, not an env var:
#   node scripts/crm-user.mjs --email kevin@example.com --name "Kevin Carey"
# A PLATFORM_OWNER_EMAILS address always gets in, allowlist or not.
#
# The postal address printed on every cold email. CAN-SPAM requires a real
# one, so with this unset the Compose panel says so and Send stays disabled.
CRM_POSTAL_ADDRESS=ClubMode, 123 Example St, Walnut Creek, CA 94595
# Optional. Defaults to "ClubMode Sales <sales@mail.clubmode.ai>". Must be on
# a domain VERIFIED in Resend — today that is mail.clubmode.ai, NOT the apex
# clubmode.ai, which Resend would reject.
CRM_FROM_EMAIL=ClubMode Sales <sales@mail.clubmode.ai>
#
# The outreach deck (/crm/deck) sends from its OWN verified subdomain, never
# from mail.clubmode.ai. Cold mail earns complaints even when it is good, and
# a complaint rate belongs to a domain — so the domain that carries customers'
# registration confirmations and match reminders must not be the one taking
# that risk. Optional; defaults to the value below.
OUTREACH_FROM_EMAIL=ClubMode <hello@outreach.clubmode.ai>
# Svix signing secret for the Resend webhook (/api/webhooks/resend), which
# suppresses an address on a hard bounce and a club on a complaint. UNSET
# MEANS THE ROUTE REFUSES EVERY REQUEST: an open endpoint that writes to a
# suppression list is a way for a stranger to delete the pipeline.
RESEND_WEBHOOK_SECRET=whsec_your_secret
